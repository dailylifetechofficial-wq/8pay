  "q": "What is basic pay on a central government payslip?",
  "a": "The pay fixed for your level and cell in the 7th CPC pay matrix, before any allowances."
 },
 {
  "q": "How is DA shown on the payslip?",
  "a": "As a percentage of basic pay. It is 63% from 1 July 2026."
 },
 {
  "q": "What is the NPS deduction?",
  "a": "10% of basic pay plus DA for employees covered by the National Pension System or the Unified Pension Scheme."
 },
 {
  "q": "Why is HRA not on my payslip?",
  "a": "HRA is not paid if you live in government-provided accommodation; a licence fee is deducted instead."
 }

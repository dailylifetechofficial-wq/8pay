 {
  "q": "How is in-hand salary calculated for government employees?",
  "a": "In-hand salary equals gross pay (basic, DA, HRA and Transport Allowance) minus deductions such as the 10% NPS or UPS contribution, CGHS, CGEGIS, income tax and other recoveries."
 },
 {
  "q": "Is NPS deducted on basic pay or on basic plus DA?",
  "a": "The 10% employee contribution is calculated on basic pay plus Dearness Allowance."
 },
 {
  "q": "Does this calculator include income tax?",
  "a": "No. Income tax depends on your declarations and regime, so enter any tax deducted each month in the other deductions box."
 },
 {
  "q": "Why is my payslip different from the result?",
  "a": "Your payslip may include a higher-TPTA city allowance, arrears, special allowances or different CGHS and recovery amounts. The payslip is always the final authority."

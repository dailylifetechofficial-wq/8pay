---
export interface Props { name: string; title: string; intro?: string; preset?: Record<string, string | number> }
const { name, title, intro, preset } = Astro.props;
const presetJson = preset ? JSON.stringify(preset) : undefined;
---
<section class="calc-box" aria-label={title}>
	<h2>{title}</h2>
	{intro && <p>{intro}</p>}
	<div class="calc" data-calc={name} data-preset={presetJson}></div>
	<noscript><p class="notice">This calculator needs JavaScript. The tables and explanations on this page work without it.</p></noscript>
</section>
